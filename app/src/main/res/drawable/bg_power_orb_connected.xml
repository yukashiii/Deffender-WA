<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#269D5CFF" />
        </shape>
    </item>
    <item android:top="20dp" android:bottom="20dp" android:left="20dp" android:right="20dp">
        <shape android:shape="oval">
            <solid android:color="#409D5CFF" />
        </shape>
    </item>
    <item android:top="40dp" android:bottom="40dp" android:left="40dp" android:right="40dp">
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#B37CFF"
                android:endColor="#7C3AED" />
            <stroke android:width="2dp" android:color="#E0C3FC" />
        </shape>
    </item>
</layer-list>
